            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Award Badge",
        "tags": [
          "badges"
        ]
      }
    },
    "/goals": {
      "get": {
        "description": "현재 인증 사용자의 목표 목록을 반환한다.",
        "operationId": "getGoals",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GoalResponse"
                  },
                  "title": "Response Getgoals",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Goals",
        "tags": [
          "goals"
        ]
      },
      "put": {
        "description": "목표를 생성하거나 갱신한다. 이미 존재하면 덮어쓴다 (upsert).",
        "operationId": "upsertGoal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upsert Goal",
        "tags": [
          "goals"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "프로세스 가동 상태. JWT 불필요 — startup/liveness probe 전용 (DB 비검사).",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthcheck",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Readiness probe — DB 연결 가능 시에만 200, 아니면 503 → 트래픽 차단.\n\n5초 주기 probe 라 글로벌 500 핸들러(Sentry 포착)를 안 타도록 여기서 직접 503.\n두 분기 모두 JSONResponse — union 반환의 OpenAPI/mypy 잡음 회피.",
        "operationId": "healthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/privacy": {
      "get": {
        "description": "개인정보 처리방침(Play Store 개인정보 URL 등록 대상).",
        "operationId": "getPrivacyPolicy",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Privacy Policy",
        "tags": [
          "legal"
        ]
      }
    },
    "/profile": {
      "get": {
        "description": "현재 인증 사용자의 프로필을 반환한다. 없으면 404.",
