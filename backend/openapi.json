                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Confirm Fallback",
        "tags": [
          "auth"
        ]
      }
    },
    "/badges": {
      "get": {
        "description": "현재 인증 사용자가 획득한 배지 목록을 반환한다.",
        "operationId": "getBadges",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
