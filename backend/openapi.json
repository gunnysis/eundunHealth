{
  "components": {
    "schemas": {
      "BadgeResponse": {
        "properties": {
          "badgeKey": {
            "title": "Badgekey",
            "type": "string"
          },
          "earnedAt": {
            "title": "Earnedat",
            "type": "string"
          }
        },
        "required": [
          "badgeKey",
          "earnedAt"
        ],
        "title": "BadgeResponse",
        "type": "object"
      },
      "CompletionRequest": {
        "description": "day-level 완료 토글 — Android HomeScreen UX와 일치.\n\n하루를 통째로 완료 처리 (해당 date의 모든 exercises 일괄 완료 + day의 isCompleted 갱신).\n이전 exercise-level (day_index, exercise_index) 구조는 Android UX와 불일치해서 422 fail이었다.",
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "boolean"
          },
          "date": {
            "title": "Date",
            "type": "string"
          },
          "manual": {
            "default": true,
            "title": "Manual",
            "type": "boolean"
          },
          "weekStart": {
            "title": "Weekstart",
            "type": "string"
          }
        },
        "required": [
          "weekStart",
          "date",
          "completed"
        ],
        "title": "CompletionRequest",
        "type": "object"
      },
      "GoalRequest": {
        "description": "PUT /goals — goal_type별 1개. 동일 type 재등록 시 target_value 갱신.",
        "properties": {
          "goalType": {
            "enum": [
              "weight",
              "body_fat"
            ],
            "title": "Goaltype",
            "type": "string"
          },
          "targetValue": {
            "exclusiveMinimum": 0.0,
            "maximum": 500.0,
            "title": "Targetvalue",
            "type": "number"
          }
        },
        "required": [
          "goalType",
          "targetValue"
        ],
        "title": "GoalRequest",
        "type": "object"
      },
      "GoalResponse": {
        "properties": {
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "goalType": {
            "title": "Goaltype",
            "type": "string"
          },
          "targetValue": {
            "title": "Targetvalue",
            "type": "number"
          }
        },
        "required": [
          "goalType",
          "targetValue",
          "createdAt"
        ],
        "title": "GoalResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProfileHistoryEntry": {
        "properties": {
          "bodyFatPct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bodyfatpct"
          },
          "heightCm": {
            "title": "Heightcm",
            "type": "number"
          },
          "muscleMassKg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Musclemasskg"
          },
          "recordedAt": {
            "title": "Recordedat",
            "type": "string"
          },
          "weightKg": {
            "title": "Weightkg",
            "type": "number"
          }
        },
        "required": [
          "heightCm",
          "weightKg",
          "bodyFatPct",
          "muscleMassKg",
          "recordedAt"
        ],
        "title": "ProfileHistoryEntry",
        "type": "object"
      },
      "StatisticsResponse": {
        "description": "최근 N주(기본 12주) 완료율 + 현재/최장 스트릭.\n\n- weekly_rates: 주 단위 완료율, week_start 오름차순(차트용)\n- current_streak: 가장 최근 주부터 연속으로 100% 완료한 주 수\n- longest_streak: 전체 기간에서 100% 완료한 최장 연속 주 수",
        "properties": {
          "currentStreak": {
            "title": "Currentstreak",
            "type": "integer"
          },
          "longestStreak": {
            "title": "Longeststreak",
            "type": "integer"
          },
          "weeklyRates": {
            "items": {
              "$ref": "#/components/schemas/WeeklyRateDto"
            },
            "title": "Weeklyrates",
            "type": "array"
          }
        },
        "required": [
          "weeklyRates",
          "currentStreak",
          "longestStreak"
        ],
        "title": "StatisticsResponse",
        "type": "object"
      },
      "UserProfileRequest": {
        "properties": {
          "bodyFatPct": {
            "anyOf": [
              {
                "maximum": 70.0,
                "minimum": 1.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bodyfatpct"
          },
          "heightCm": {
            "maximum": 300.0,
            "minimum": 50.0,
            "title": "Heightcm",
            "type": "number"
          },
          "muscleMassKg": {
            "anyOf": [
              {
                "maximum": 200.0,
                "minimum": 1.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Musclemasskg"
          },
          "restDay": {
            "default": 7,
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Restday",
            "type": "integer"
          },
          "weightKg": {
            "maximum": 500.0,
            "minimum": 10.0,
            "title": "Weightkg",
            "type": "number"
          }
        },
        "required": [
          "heightCm",
          "weightKg"
        ],
        "title": "UserProfileRequest",
        "type": "object"
      },
      "UserProfileResponse": {
        "properties": {
          "bodyFatPct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bodyfatpct"
          },
          "heightCm": {
            "title": "Heightcm",
            "type": "number"
          },
          "muscleMassKg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Musclemasskg"
          },
          "restDay": {
            "default": 7,
            "title": "Restday",
            "type": "integer"
          },
          "userId": {
            "title": "Userid",
            "type": "string"
          },
          "weightKg": {
            "title": "Weightkg",
            "type": "number"
          }
        },
        "required": [
          "userId",
          "heightCm",
          "weightKg",
          "bodyFatPct",
          "muscleMassKg"
        ],
        "title": "UserProfileResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WeeklyPlanHistoryResponse": {
        "description": "페이지네이션 메타를 포함한 history envelope.\n\nAndroid의 HistoryViewModel이 total_count를 받아 페이지 인디케이터에 사용한다.\n이전엔 `list[WeeklyPlanResponse]`만 반환해서 Android Gson deserialization이 실패했다.",
        "properties": {
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "plans": {
            "items": {
              "$ref": "#/components/schemas/WeeklyPlanResponse"
            },
            "title": "Plans",
            "type": "array"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "totalCount": {
            "title": "Totalcount",
            "type": "integer"
          }
        },
        "required": [
          "plans",
          "totalCount",
          "page",
          "size"
        ],
        "title": "WeeklyPlanHistoryResponse",
        "type": "object"
      },
      "WeeklyPlanRequest": {
        "properties": {
          "dayPlans": {
            "title": "Dayplans",
            "type": "string"
          },
          "weekStart": {
            "title": "Weekstart",
            "type": "string"
          }
        },
        "required": [
          "weekStart",
          "dayPlans"
        ],
        "title": "WeeklyPlanRequest",
        "type": "object"
      },
      "WeeklyPlanResponse": {
        "properties": {
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdat"
          },
          "dayPlans": {
            "title": "Dayplans",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "userId": {
            "title": "Userid",
            "type": "string"
          },
          "weekStart": {
            "title": "Weekstart",
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "weekStart",
          "dayPlans"
        ],
        "title": "WeeklyPlanResponse",
        "type": "object"
      },
      "WeeklyRateDto": {
        "description": "한 주의 운동 완료율 (0.0 ~ 1.0).",
        "properties": {
          "completionRate": {
            "title": "Completionrate",
            "type": "number"
          },
          "weekStart": {
            "title": "Weekstart",
            "type": "string"
          }
        },
        "required": [
          "weekStart",
          "completionRate"
        ],
        "title": "WeeklyRateDto",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "eundunHealth API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/assetlinks.json": {
      "get": {
        "description": "Android App Links 검증용 assetlinks.json을 반환한다.",
        "operationId": "getAssetlinks",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Getassetlinks",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Assetlinks Json",
        "tags": [
          "auth"
        ]
      }
    },
    "/account": {
      "delete": {
        "description": "현재 인증 사용자의 계정을 삭제한다. Supabase Auth + 앱 DB 데이터 모두 제거.",
        "operationId": "deleteAccount",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Deleteaccount",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Account",
        "tags": [
          "account"
        ]
      }
    },
    "/account-deletion": {
      "get": {
        "description": "계정 및 데이터 삭제 안내(Play Store 계정 삭제 요청 URL 등록 대상).",
        "operationId": "getAccountDeletion",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Account Deletion",
        "tags": [
          "legal"
        ]
      }
    },
    "/auth/confirm": {
      "get": {
        "description": "앱 미설치 디바이스용 이메일 인증 완료 fallback 페이지를 반환한다.",
