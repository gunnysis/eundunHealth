                    "$ref": "#/components/schemas/BadgeResponse"
                  },
                  "title": "Response Getbadges",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Badges",
        "tags": [
          "badges"
        ]
      }
    },
    "/badges/{key}": {
      "post": {
        "description": "지정한 key 의 배지를 사용자에게 부여한다. 이미 보유하면 409 반환.",
        "operationId": "awardBadge",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeResponse"
                }
              }
