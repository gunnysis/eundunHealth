# local.properties 예시 — 실제 값으로 채워서 local.properties 파일로 복사한다.
# 이 파일은 git에 커밋되지만 local.properties 자체는 .gitignore되어 있다.

# Android SDK (Android Studio가 자동 설정)
# sdk.dir=C:\\Users\\<USER>\\AppData\\Local\\Android\\Sdk

# Supabase (Android 클라이언트용 — anon key만)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
# 주의: SERVICE_ROLE_KEY는 백엔드 환경변수로만 사용. Android local.properties에 두지 말 것.

# ExerciseDB — OSS 공개 API 사용 중 (인증 없음)
# https://oss.exercisedb.dev — RapidAPI 키 불필요. EXERCISEDB_API_KEY 항목은 제거됨.

# Backend
# 에뮬레이터: http://10.0.2.2:8080/
# 실기기 디버그: http://<host-ip>:8080/
# 프로덕션: Container App FQDN
BACKEND_BASE_URL=http://10.0.2.2:8080/

# Sentry — 프로젝트별로 DSN 분리 (Android 앱 / 백엔드)
# Android: BuildConfig.SENTRY_DSN으로 매핑되어 EundunHealthApplication.kt에서 init.
#          실제 Sentry 프로젝트 slug: "eundunhealth"
# Backend: Container App secret(sentry-dsn-backend)으로 등록 — 이 파일은 참고용이며
#          앱 빌드에는 영향 없음. 실제 Sentry 프로젝트 slug: "eundunhealth-backend"
# NOTE: 변수명의 prefix(eundunhealth-app_, eundunhealth-backend_)는 단순 식별용 prefix이며
#       실제 Sentry slug과 다름.
eundunhealth-app_SENTRY_DSN=https://<android-key>@sentry.io/<project>
eundunhealth-backend_SENTRY_DSN=https://<backend-key>@sentry.io/<project>

# (옵션) Sentry Gradle plugin 프로젝트 slug. 기본값 "eundunhealth".
# 향후 slug이 바뀌면 이 값으로 override (ProGuard mapping 업로드용).
# SENTRY_PROJECT_ANDROID=eundunhealth

# Sentry Gradle plugin auth token (release 빌드의 ProGuard mapping 업로드용)
# 또는 환경변수 SENTRY_AUTH_TOKEN을 export 해도 됨
SENTRY_AUTH_TOKEN=sntrys_...

# Release Signing — keystore 비번/별칭 (release build 시 필요)
# RELEASE_KEY_ALIAS는 .key/eundunhealth_upload_key 파일의 실제 alias와 일치해야 함
#   keytool -list -v -keystore .key/eundunhealth_upload_key 로 확인
RELEASE_STORE_PASSWORD=your-store-password
RELEASE_KEY_PASSWORD=your-key-password
RELEASE_KEY_ALIAS=your-actual-alias
